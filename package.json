{
  "name": "temel-egitim-studio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:voicestudio": "node scripts/dev-with-voicestudio.mjs",
    "build": "tsc --noEmit && vite build",
    "audit": "esbuild scripts/audit.ts --bundle --platform=node --outfile=node_modules/.tempo-audit.cjs --log-level=error && node node_modules/.tempo-audit.cjs",
    "contexts": "esbuild scripts/build-context.ts --bundle --platform=node --outfile=node_modules/.tempo-context.cjs --log-level=error && node node_modules/.tempo-context.cjs",
    "books": "python3 scripts/extract-books.py",
    "books:questions": "python3 scripts/extract-book-questions.py",
    "parallels": "node scripts/build-book-parallels.mjs",
    "all:questions": "npm run contexts && npm run books:questions && npm run parallels && npm run contexts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
